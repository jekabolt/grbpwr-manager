{{define "block_product_card"}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="gp-pad" style="padding:24px 32px;">
      <a href="{{.ProductCard.Product.URL}}" style="display:block;color:#0e0e0c;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td width="46%" valign="top"><img src="{{.ProductCard.Product.Thumbnail.URL}}" width="{{.ProductCard.Product.Thumbnail.Width}}" height="{{.ProductCard.Product.Thumbnail.Height}}" alt="{{.ProductCard.Product.Name}}" style="display:block;width:100%;height:auto;border:0;"></td>
            <td width="54%" valign="middle" style="padding:12px 0 12px 24px;font-family:Arial,Helvetica,sans-serif;">
              <div style="font-size:10px;line-height:15px;letter-spacing:1.2px;text-transform:uppercase;color:#77746b;">{{.ProductCard.Product.Brand}}</div>
              <div style="margin-top:7px;font-size:19px;line-height:25px;font-weight:600;">{{.ProductCard.Product.Name}}</div>
              <div style="margin-top:12px;font-size:13px;line-height:18px;">{{if .ProductCard.Product.OnSale}}<span style="text-decoration:line-through;color:#8b887f;">{{.ProductCard.Product.OriginalPrice}}</span>&nbsp; {{end}}{{.ProductCard.Product.Price}}</div>
            </td>
          </tr>
        </table>
      </a>
    </td>
  </tr>
</table>
{{end}}
