{{define "block_product_card"}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="gp-pad" align="center" style="padding:24px 40px;font-family:'SF Mono','SFMono-Regular',ui-monospace,Menlo,Consolas,'Courier New',monospace;">
      <!-- Borderless storefront catalog card: full-width portrait thumbnail with the
           name + price left-aligned beneath it (the catalog look). -->
      <a href="{{.ProductCard.Product.URL}}" style="display:inline-block;text-decoration:none;color:{{.Palette.Text}};">
        <table role="presentation" width="360" cellpadding="0" cellspacing="0" border="0" style="width:360px;max-width:100%;">
          <tr>
            <td style="padding:0;font-size:0;line-height:0;">
              <img src="{{.ProductCard.Product.Thumbnail.URL}}" width="360" alt="{{.ProductCard.Product.Name}}" style="display:block;width:100%;max-width:360px;height:auto;border:0;">
            </td>
          </tr>
          <tr>
            <td align="left" style="padding-top:10px;text-align:left;">
              <div style="font-size:12px;line-height:14px;text-decoration:underline;color:{{.Palette.Text}};">{{.ProductCard.Product.Name}}</div>
              <div style="padding-top:6px;font-size:12px;line-height:16px;color:{{.Palette.Text}};">{{if .ProductCard.Product.OnSale}}<span style="text-decoration:line-through;color:{{.Palette.Muted}};">{{.ProductCard.Product.OriginalPrice}}</span>&nbsp;{{.ProductCard.Product.Price}}{{else}}{{.ProductCard.Product.Price}}{{end}}</div>
            </td>
          </tr>
        </table>
      </a>
    </td>
  </tr>
</table>
{{end}}
