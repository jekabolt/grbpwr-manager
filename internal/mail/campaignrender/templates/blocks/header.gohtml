{{define "block_header"}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td align="center" class="gp-pad" style="padding:32px 32px 24px;font-family:Arial,Helvetica,sans-serif;color:#0e0e0c;">
      <img src="{{.Header.Logo.URL}}" width="{{.Header.Logo.Width}}" height="{{.Header.Logo.Height}}" alt="{{.Header.Logo.Alt}}" style="display:block;width:54px;max-width:54px;height:auto;margin:0 auto;border:0;">
      {{if .Copy.Heading}}<h1 style="margin:24px 0 0;font-size:28px;line-height:34px;font-weight:600;letter-spacing:-0.5px;">{{.Copy.Heading}}</h1>{{end}}
      {{if .Copy.Subheading}}<p style="margin:10px 0 0;font-size:14px;line-height:21px;color:#66635c;">{{.Copy.Subheading}}</p>{{end}}
      {{if .Copy.Links}}
      <p style="margin:18px 0 0;font-size:11px;line-height:18px;letter-spacing:1px;text-transform:uppercase;">
        {{range $i,$link := .Copy.Links}}{{if $i}} &nbsp;·&nbsp; {{end}}<a href="{{$link.URL}}" style="color:#0e0e0c;text-decoration:underline;">{{$link.Label}}</a>{{end}}
      </p>
      {{end}}
    </td>
  </tr>
</table>
{{end}}
