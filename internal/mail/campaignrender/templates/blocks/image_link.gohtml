{{define "block_image_link"}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td align="center">
      {{if .ImageLink.URL}}<a href="{{.ImageLink.URL}}" style="display:block;">{{end}}
      <img src="{{.ImageLink.Media.URL}}" width="{{.ImageLink.Media.Width}}" height="{{.ImageLink.Media.Height}}" alt="{{.Copy.AltText}}" style="display:block;width:100%;max-width:600px;height:auto;border:0;">
      {{if .ImageLink.URL}}</a>{{end}}
    </td>
  </tr>
  {{if .Copy.Caption}}<tr><td class="gp-pad" style="padding:10px 28px 20px;color:#77746b;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:17px;text-align:center;">{{.Copy.Caption}}</td></tr>{{end}}
</table>
{{end}}
