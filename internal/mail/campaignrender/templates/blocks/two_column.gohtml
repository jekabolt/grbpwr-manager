{{define "block_two_column"}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="gp-stack" width="50%" valign="top" style="width:50%;max-width:300px;">{{.TwoColumn.LeftHTML}}</td>
    <td class="gp-stack" width="50%" valign="top" style="width:50%;max-width:300px;">{{.TwoColumn.RightHTML}}</td>
  </tr>
</table>
{{end}}
