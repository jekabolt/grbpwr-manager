{{define "block_product_grid"}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="gp-pad" style="padding:22px 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        {{range rows .ProductGrid.Products .ProductGrid.Columns}}
        <tr>
          {{range .}}
          <!-- Borderless storefront catalog card: full-width portrait thumbnail with the
               name + price left-aligned beneath it. Cells stack to a single column on
               mobile via .gp-grid-cell. -->
          <td class="gp-grid-cell" width="{{gridWidth $.ProductGrid.Columns}}" valign="top" style="padding:8px;font-family:'SF Mono','SFMono-Regular',ui-monospace,Menlo,Consolas,'Courier New',monospace;">
            <a href="{{.URL}}" style="display:block;text-decoration:none;color:#0E0E0C;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="padding:0;font-size:0;line-height:0;">
                    <img src="{{.Thumbnail.URL}}" width="240" alt="{{.Name}}" style="display:block;width:100%;height:auto;border:0;">
                  </td>
                </tr>
                <tr>
                  <td align="left" style="padding-top:10px;text-align:left;">
                    <div style="font-size:12px;line-height:16px;letter-spacing:1px;text-transform:uppercase;color:#0E0E0C;">{{.Name}}</div>
                    <div style="padding-top:6px;font-size:12px;line-height:16px;color:#0E0E0C;">{{if .OnSale}}<span style="text-decoration:line-through;color:#9a978c;">{{.OriginalPrice}}</span>&nbsp;{{.Price}}{{else}}{{.Price}}{{end}}</div>
                  </td>
                </tr>
              </table>
            </a>
          </td>
          {{end}}
        </tr>
        {{end}}
      </table>
    </td>
  </tr>
</table>
{{end}}
