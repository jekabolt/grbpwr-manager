{{define "block_product_grid"}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="gp-pad" style="padding:22px 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        {{range rows .ProductGrid.Products .ProductGrid.Columns}}
        <tr>
          {{range .}}
          <!-- Borderless storefront catalog card: fixed 3/4 portrait box, image contained
               (letterboxed on the section background), name + price below. Cells stack to
               a single column on mobile via .gp-grid-cell. -->
          <td class="gp-grid-cell" width="{{gridWidth $.ProductGrid.Columns}}" valign="top" style="padding:8px;font-family:'SF Mono','SFMono-Regular',ui-monospace,Menlo,Consolas,'Courier New',monospace;">
            <a href="{{.URL}}" style="display:block;text-decoration:none;color:#0E0E0C;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" valign="middle" height="320" bgcolor="{{cssColor $.BackgroundColor "#FFFFFF"}}" style="height:320px;background-color:{{cssColor $.BackgroundColor "#FFFFFF"}};text-align:center;">
                    <img src="{{.Thumbnail.URL}}" width="240" alt="{{.Name}}" style="display:inline-block;width:auto;height:auto;max-width:240px;max-height:320px;border:0;vertical-align:middle;">
                  </td>
                </tr>
                <tr>
                  <td style="padding-top:8px;">
                    <div style="font-size:12px;line-height:14px;letter-spacing:1px;text-transform:uppercase;color:#0E0E0C;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{.Name}}</div>
                    <div style="padding-top:8px;font-size:12px;line-height:14px;color:#0E0E0C;">{{if .OnSale}}<span style="text-decoration:line-through;color:#9a978c;">{{.OriginalPrice}}</span>&nbsp;{{.Price}}{{else}}{{.Price}}{{end}}</div>
                  </td>
                </tr>
              </table>
            </a>
          </td>
          {{end}}
        </tr>
        {{end}}
      </table>
    </td>
  </tr>
</table>
{{end}}
