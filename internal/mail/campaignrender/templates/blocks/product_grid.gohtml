{{define "block_product_grid"}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="gp-pad" style="padding:22px 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        {{range rows .ProductGrid.Products .ProductGrid.Columns}}
        <tr>
          {{range .}}
          <td class="gp-grid-cell" width="{{gridWidth $.ProductGrid.Columns}}" valign="top" style="padding:8px;">
            <a href="{{.URL}}" style="display:block;color:#0e0e0c;font-family:Arial,Helvetica,sans-serif;">
              <img src="{{.Thumbnail.URL}}" width="{{.Thumbnail.Width}}" height="{{.Thumbnail.Height}}" alt="{{.Name}}" style="display:block;width:100%;height:auto;border:0;">
              <div style="margin-top:9px;font-size:9px;line-height:14px;letter-spacing:1px;text-transform:uppercase;color:#77746b;">{{.Brand}}</div>
              <div style="margin-top:3px;font-size:13px;line-height:18px;font-weight:600;">{{.Name}}</div>
              <div style="margin-top:5px;font-size:11px;line-height:16px;">{{if .OnSale}}<span style="text-decoration:line-through;color:#8b887f;">{{.OriginalPrice}}</span>&nbsp; {{end}}{{.Price}}</div>
            </a>
          </td>
          {{end}}
        </tr>
        {{end}}
      </table>
    </td>
  </tr>
</table>
{{end}}
