{{define "block_divider"}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td class="gp-pad" style="padding:18px 40px;"><div style="border-top:{{.Divider.Height}}px solid {{cssColor .Divider.Color "#0E0E0C"}};font-size:0;line-height:0;">&nbsp;</div></td></tr>
</table>
{{end}}
