{{template "email_header" (dict "tag" (t "tier.upgrade.tag") "preheader" .Preheader)}}

              <div class="gp-h" style="font-size:26px; line-height:32px; letter-spacing:1px;">{{if .IsBackfill}}{{ t "tier.upgrade.heading_backfill" }}{{else}}{{ t "tier.upgrade.heading" }}{{end}}</div>
              {{template "spacer_18"}}
              {{if .Name}}<div style="font-size:13px; line-height:22px; color:#0E0E0C;">{{.Name}},</div>{{template "spacer_12"}}{{end}}
              <div style="font-size:13px; line-height:22px; color:#5d5a51;">{{if .IsBackfill}}{{ tHTML "tier.upgrade.body_backfill" "Tier" (emph .TierDisplay) }}{{else}}{{ tHTML "tier.upgrade.body_reached" "Tier" (emph .TierDisplay) }}{{end}}</div>
              {{template "spacer_22"}}
              {{template "hairline"}}
              {{template "spacer_16"}}
              <table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
                <tr><td style="font-size:11px; letter-spacing:0.3px; color:#9a978c;">{{ t "tier.upgrade.spend_label" }}</td><td align="right" style="font-size:13px; color:#0E0E0C;">€{{.SpendEUR}}</td></tr>
                {{if .NextReview}}<tr><td style="font-size:11px; letter-spacing:0.3px; color:#9a978c; padding-top:8px;">{{ t "tier.upgrade.maintain_label" }}</td><td align="right" style="font-size:13px; color:#0E0E0C; padding-top:8px;">{{.NextReview}}</td></tr>{{end}}
              </table>
              {{template "spacer_16"}}
              {{template "hairline"}}
              {{template "spacer_26"}}
              {{template "cta_button" (dict "url" "https://grbpwr.com/account" "label" (t "common.cta.view_account") "variant" "solid")}}
              {{template "spacer_22"}}
              <div style="font-size:12px; letter-spacing:1px; color:#9a978c;">— GRBPWR</div>

{{template "email_footer" .}}
