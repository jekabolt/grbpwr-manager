{{define "order_track_link"}}
              {{ with shop }}{{ if .URL }}{{template "cta_button" (dict "url" (printf "%s/order/%s/%s" .URL $.OrderUUID $.EmailB64) "label" (t "common.order.track.label") "variant" "outline")}}{{ end }}{{ else }}{{template "cta_button" (dict "url" (printf "https://grbpwr.com/order/%s/%s" .OrderUUID .EmailB64) "label" (t "common.order.track.label") "variant" "outline")}}{{ end }}
{{end}}
