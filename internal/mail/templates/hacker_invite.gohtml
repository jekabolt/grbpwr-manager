{{template "email_header" (dict "tag" (t "hacker.invite.tag") "preheader" (t "hacker.invite.preheader"))}}

              <div class="gp-h" style="font-size:26px; line-height:32px; letter-spacing:1px;">{{ t "hacker.invite.heading" }}</div>
              {{template "spacer_18"}}
              <div style="font-size:13px; line-height:22px; color:#5d5a51;">{{ tHTML "hacker.invite.body" }}</div>
              {{template "spacer_18"}}
              <div style="font-size:13px; line-height:22px; color:#5d5a51;">{{ tHTML "hacker.invite.body2" "Date" (emph .ExpiresAt) }}</div>
              {{template "spacer_26"}}
              {{template "cta_button" (dict "url" .InviteURL "label" (t "hacker.invite.cta") "variant" "solid")}}
              {{template "spacer_22"}}
              <div style="font-size:11px; line-height:18px; color:#9a978c;">{{ t "hacker.invite.fallback_link" }}<br><span style="color:#0E0E0C; word-break:break-all;">{{.InviteURL}}</span></div>
              {{template "spacer_22"}}
              <div style="font-size:12px; letter-spacing:1px; color:#9a978c;">— GRBPWR</div>

{{template "email_footer" .}}
