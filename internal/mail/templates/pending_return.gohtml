{{template "email_header" (dict "tag" (t "order.return.tag") "preheader" (t "order.return.preheader"))}}

              <div class="gp-h" style="font-size:26px; line-height:32px; letter-spacing:1px;">{{ t "order.return.heading" }}</div>
              {{template "spacer_18"}}
              {{template "order_meta" (dict "uuid" .OrderUUID "email" .EmailB64 "status" (t "order.return.heading") "buyer" .BuyerName)}}

              {{template "spacer_20"}}
              {{template "hairline"}}
              {{template "spacer_18"}}
              <div style="font-size:13px; line-height:22px; color:#5d5a51;">{{ t "order.return.body" }}</div>
              {{template "spacer_18"}}
              <div style="font-size:12px; letter-spacing:1px; color:#9a978c;">{{ t "common.signoff.patience" }}</div>

{{template "email_footer" .}}
