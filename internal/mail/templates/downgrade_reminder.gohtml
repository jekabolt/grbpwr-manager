{{template "email_header" (dict "tag" (t "tier.reminder.tag") "preheader" (t "tier.reminder.preheader"))}}

              <div class="gp-h" style="font-size:26px; line-height:32px; letter-spacing:1px;">{{ t "tier.reminder.heading" }}</div>
              {{template "spacer_18"}}
              {{if .Name}}<div style="font-size:13px; line-height:22px; color:#0E0E0C;">{{.Name}},</div>{{template "spacer_12"}}{{end}}
              <div style="font-size:13px; line-height:22px; color:#5d5a51;">{{ tHTML "tier.reminder.body" "Tier" (emph .TierDisplay) "Date" (emph .NextReview) }}</div>
              {{template "spacer_18"}}
              {{if .ThresholdEUR}}<div style="font-size:13px; line-height:22px; color:#5d5a51;">{{ t "tier.reminder.body2_threshold" "Spend" .SpendEUR "Threshold" .ThresholdEUR }}</div>{{else}}<div style="font-size:13px; line-height:22px; color:#5d5a51;">{{ t "tier.reminder.body2" "Spend" .SpendEUR }}</div>{{end}}
              {{template "spacer_26"}}
              {{template "cta_button" (dict "url" "https://grbpwr.com" "label" (t "common.cta.shop") "variant" "solid")}}
              {{template "spacer_22"}}
              <div style="font-size:12px; letter-spacing:1px; color:#9a978c;">— GRBPWR</div>

{{template "email_footer" .}}
