{{template "email_header" (dict "tag" (t "unsubscribe.confirm.tag") "preheader" (t "unsubscribe.confirm.preheader"))}}

              <div class="gp-h" style="font-size:26px; line-height:32px; letter-spacing:1px;">{{ t "unsubscribe.confirm.heading" }}</div>
              {{template "spacer_18"}}
              {{if .Name}}<div style="font-size:13px; line-height:22px; color:#0E0E0C;">{{.Name}},</div>{{template "spacer_12"}}{{end}}
              <div style="font-size:13px; line-height:22px; color:#5d5a51;">{{ t "unsubscribe.confirm.body" }}</div>
              {{template "spacer_18"}}
              <div style="font-size:13px; line-height:22px; color:#5d5a51;">{{ t "unsubscribe.confirm.body2" }}</div>
              {{template "spacer_26"}}
              {{template "cta_button" (dict "url" "https://grbpwr.com/account" "label" (t "common.cta.email_preferences"))}}
              {{template "spacer_22"}}
              <div style="font-size:12px; letter-spacing:1px; color:#9a978c;">— GRBPWR</div>

{{template "email_footer" .}}
