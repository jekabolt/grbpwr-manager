{{define "body"}}<tr><td style="font-size:20px;padding:0 0 4px 0;">{{.Team}}</td></tr>
{{if .From}}<tr><td style="font-size:13px;color:#777777;">from {{.From}}</td></tr>{{end}}
{{template "button" (button .Link (print "join " .Team))}}
<tr><td style="font-size:12px;color:#777777;">valid 7 days</td></tr>{{end}}
