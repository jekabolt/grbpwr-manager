{{define "body"}}<tr><td style="font-size:20px;padding:0 0 4px 0;">{{.Team}}</td></tr>
{{if .Address}}<tr><td style="font-size:13px;color:#777777;">{{.Address}}</td></tr>{{end}}
<tr><td style="font-size:34px;letter-spacing:0.12em;padding:8px 0;font-variant-numeric:tabular-nums;">{{.Code}}</td></tr>
{{template "button" (button .Link "return to join")}}
<tr><td style="font-size:12px;color:#777777;">valid 24 h</td></tr>{{end}}
